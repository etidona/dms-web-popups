{
    "$schema": "https://github.com/duxlabs-dev/dux-shell/raw/refs/heads/master/quickshell/PLUGINS/plugin-schema.json",
    "id": "webPopups",
    "name": "Web Popups",
    "description": "Open any web app (WhatsApp, Telegram, Discord, YouTube...) in a popup next to the bar: one button per app or one group button, with unread badges, notifications, separate logins, and per-app mute and audio output",
    "version": "0.4.0",
    "license": "GPL-3.0-or-later",
    "author": "etidona",
    "type": "widget",
    "capabilities": [
        "dankbar-widget",
        "variants"
    ],
    "component": "./WebPopupsWidget.qml",
    "settings": "./WebPopupsSettings.qml",
    "startupCheck": "./StartupCheck.qml",
    "icon": "web",
    "dependencies": [
        "python3",
        "python3-pyqt6-webengine",
        "layer-shell-qt",
        "xdg-utils",
        "pulseaudio-utils"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ],
    "requires_dms": ">=2.0.0",
    "compositors": [
        "any"
    ]
}
